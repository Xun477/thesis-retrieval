# paper-research API keys 配置模板
#
# 使用方式（二选一）：
#   1) 复制本文件为 resources/config/config.local.env 并填写
#      （config.local.env 已被 .gitignore 忽略，不会提交到仓库）；
#   2) 或直接设置同名环境变量。
#
# 可选——脚本会自动从环境变量 / pybliometrics.cfg / lit-dl credentials.json 读取
# 若下面留空，脚本会尝试从其他位置自动发现 key

# Elsevier Scopus API key
SCOPUS_API_KEY=

# Clarivate Web of Science Starter API key
WOS_API_KEY=

# OpenAlex/CrossRef polite pool 邮箱（推荐填写真实邮箱提升限流额度）
OPENALEX_MAILTO=

# 可选：Semantic Scholar API key（免费申请，提升共享限流 rps）
#   无 key 也可用，但高峰期共享限流（可能 429）。申请: https://www.semanticscholar.org/product/api
S2_API_KEY=

# 可选：NCBI API key（免费注册，将 PubMed E-utilities 限流从 3 rps 提升到 10 rps）
#   无 key 也可用，但限 3 rps。注册: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
